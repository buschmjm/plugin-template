Group {
    Anchor: (Full: 0);
    LayoutMode: Center;
    Background: #000000(0.5);

    Group #Panel {
        Anchor: (Width: 780, Height: 560);
        LayoutMode: Top;
        Padding: (Top: 20, Bottom: 20, Left: 15, Right: 15);
        Background: #1A1A2E(0.9);
        OutlineColor: #4A4A7E;
        OutlineSize: 2;

        Group #TopBar {
            Anchor: (Height: 36);
            LayoutMode: Left;
            TextButton #BtnBack {
                Anchor: (Width: 80, Height: 30);
                Text: "Back";
                Background: #3A3A5E(0.9);
                OutlineColor: #5A5A8E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Label #Title {
                Anchor: (Width: 650, Height: 30);
                Text: "Abilities";
                Style: (FontSize: 22, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
        }

        Group #HintBox {
            Anchor: (Height: 36);
            Background: #0D1B2A(0.85);
            OutlineColor: #2A4A6E;
            OutlineSize: 1;
            Padding: (Left: 10, Right: 10);
            Label #HintLabel {
                Anchor: (Height: 36);
                Text: "Press Q to use Slot 1  |  Press E to use Slot 2  |  Press R to use Slot 3";
                Style: (FontSize: 13, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
        }

        Group { Anchor: (Height: 6); }

        Group #SlotList {
            Anchor: (Height: 98);
            LayoutMode: Top;
            TextButton #SlotBtn1 {
                Anchor: (Height: 28);
                Text: "[ Q ]  Slot 1: (empty)";
                Background: #2E2E5E(0.7);
                OutlineColor: #5A5A8E;
                OutlineSize: 1;
                Padding: (Left: 10);
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group { Anchor: (Height: 4); }
            TextButton #SlotBtn2 {
                Anchor: (Height: 28);
                Text: "[ E ]  Slot 2: (empty)";
                Background: #2E2E5E(0.7);
                OutlineColor: #5A5A8E;
                OutlineSize: 1;
                Padding: (Left: 10);
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group { Anchor: (Height: 4); }
            TextButton #SlotBtn3 {
                Anchor: (Height: 28);
                Text: "[ R ]  Slot 3: (empty)";
                Background: #2E2E5E(0.7);
                OutlineColor: #5A5A8E;
                OutlineSize: 1;
                Padding: (Left: 10);
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
        }

        Group { Anchor: (Height: 6); }

        Group #PageRow {
            Anchor: (Height: 30);
            LayoutMode: Left;
            TextButton #BtnPagePrev {
                Anchor: (Width: 60, Height: 26);
                Text: "<< Pg";
                Background: #3A3A5E(0.9);
                OutlineColor: #5A5A8E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Label #PageLabel {
                Anchor: (Width: 200, Height: 26);
                Text: "Strength (Knight)";
                Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
            }
            TextButton #BtnPageNext {
                Anchor: (Width: 60, Height: 26);
                Text: "Pg >>";
                Background: #3A3A5E(0.9);
                OutlineColor: #5A5A8E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
        }

        Group #ResourceRow {
            Anchor: (Height: 28);
            LayoutMode: Left;
            Label #ManaLabel {
                Anchor: (Width: 255, Height: 24);
                Text: "Mana: 50 / 50";
                Background: #2A2A6E(0.7);
                OutlineColor: #4A4A8E;
                OutlineSize: 1;
                Padding: (Left: 10);
                Style: (VerticalAlignment: Center);
            }
            Group { Anchor: (Width: 10); }
            Label #StaminaLabel {
                Anchor: (Width: 255, Height: 24);
                Text: "Stamina: 100 / 100";
                Background: #2A6A2A(0.7);
                OutlineColor: #3A8A3A;
                OutlineSize: 1;
                Padding: (Left: 10);
                Style: (VerticalAlignment: Center);
            }
        }

        Label #AbilityHeader {
            Anchor: (Height: 26);
            Text: "Select an ability, then click a slot above to bind it:";
            Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
        }

        Group #AbilityList {
            Anchor: (Height: 228);
            LayoutMode: Top;
            TextButton #AbilityBtn1 {
                Anchor: (Height: 48);
                Text: "";
                Background: #3A3A3A(0.7);
                OutlineColor: #4A4A4A;
                OutlineSize: 1;
                Padding: (Left: 10, Right: 10, Top: 4, Bottom: 4);
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group #Sp1 { Anchor: (Height: 4); }
            TextButton #AbilityBtn2 {
                Anchor: (Height: 48);
                Text: "";
                Background: #3A3A3A(0.7);
                OutlineColor: #4A4A4A;
                OutlineSize: 1;
                Padding: (Left: 10, Right: 10, Top: 4, Bottom: 4);
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group #Sp2 { Anchor: (Height: 4); }
            TextButton #AbilityBtn3 {
                Anchor: (Height: 48);
                Text: "";
                Background: #3A3A3A(0.7);
                OutlineColor: #4A4A4A;
                OutlineSize: 1;
                Padding: (Left: 10, Right: 10, Top: 4, Bottom: 4);
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group #Sp3 { Anchor: (Height: 4); }
            TextButton #AbilityBtn4 {
                Anchor: (Height: 48);
                Text: "";
                Background: #3A3A3A(0.7);
                OutlineColor: #4A4A4A;
                OutlineSize: 1;
                Padding: (Left: 10, Right: 10, Top: 4, Bottom: 4);
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
        }
    }
}
