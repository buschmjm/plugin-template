                    }
                    TextButton #CatGloves {
                        Anchor: (Width: 54, Height: 24);
                        Text: "Gloves";
                        Background: #2A4A2E(0.9);
                        OutlineColor: #4A6A4E;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                    TextButton #CatLegs {
                        Anchor: (Width: 48, Height: 24);
                        Text: "Legs";
                        Background: #2A4A2E(0.9);
                        OutlineColor: #4A6A4E;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                }

                Group { Anchor: (Height: 4); }

                Group #ItemList {
                    Anchor: (Height: 410);
