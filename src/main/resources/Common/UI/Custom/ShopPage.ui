                        Background: #4E2A2A(0.9);
                        OutlineColor: #8E4A4A;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
