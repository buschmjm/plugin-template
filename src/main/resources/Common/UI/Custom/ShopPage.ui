Group {
    Anchor: (Full: 0);
    LayoutMode: Center;
    Background: #000000(0.55);

    Group #Panel {
        Anchor: (Width: 820, Height: 620);
        LayoutMode: Top;
        Padding: (Top: 14, Bottom: 14, Left: 14, Right: 14);
        Background: #111122(0.95);
        OutlineColor: #3A3A6E;
        OutlineSize: 2;

        Group #TopBar {
            Anchor: (Height: 38);
            LayoutMode: Left;
            TextButton #BtnBack {
                Anchor: (Width: 70, Height: 30);
                Text: "Back";
                Background: #2A2A4E(0.9);
                OutlineColor: #4A4A7E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Label #Title {
                Anchor: (Width: 660, Height: 34);
                Text: "Weapon Shop";
                Style: (FontSize: 22, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
        }

        Group #GoldBar {
            Anchor: (Height: 28);
            Background: #1A1A30(0.8);
            Padding: (Left: 10, Right: 10);
            LayoutMode: Left;
            Label #GoldDisplay {
                Anchor: (Width: 400, Height: 28);
                Text: "Gold: 0";
                Style: (VerticalAlignment: Center);
            }
        }

        Group { Anchor: (Height: 6); }

        Group #Body {
            Anchor: (Height: 500);
            LayoutMode: Left;

            Group #LeftPanel {
                Anchor: (Width: 350, Height: 500);
                LayoutMode: Top;
                Padding: (Right: 6);

                Group #CategoryRow1 {
                    Anchor: (Height: 28);
                    LayoutMode: Left;
                    TextButton #CatSwords {
                        Anchor: (Width: 68, Height: 24);
                        Text: "Swords";
                        Background: #4A3A6E(0.9);
                        OutlineColor: #6A5A9E;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                    TextButton #CatAxes {
                        Anchor: (Width: 48, Height: 24);
                        Text: "Axes";
                        Background: #2A2A4E(0.9);
                        OutlineColor: #4A4A7E;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                    TextButton #CatDaggers {
                        Anchor: (Width: 62, Height: 24);
                        Text: "Daggers";
                        Background: #2A2A4E(0.9);
                        OutlineColor: #4A4A7E;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                    TextButton #CatSpears {
                        Anchor: (Width: 56, Height: 24);
                        Text: "Spears";
                        Background: #2A2A4E(0.9);
                        OutlineColor: #4A4A7E;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                }

                Group #CategoryRow2 {
                    Anchor: (Height: 28);
                    LayoutMode: Left;
                    TextButton #CatStaves {
                        Anchor: (Width: 56, Height: 24);
                        Text: "Staves";
                        Background: #2A2A4E(0.9);
                        OutlineColor: #4A4A7E;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                    TextButton #CatBows {
                        Anchor: (Width: 48, Height: 24);
                        Text: "Bows";
                        Background: #2A2A4E(0.9);
                        OutlineColor: #4A4A7E;
                        OutlineSize: 1;
                        Style: (Default: (LabelStyle: (FontSize: 10, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                    TextButton #CatXbows {
                        Anchor: (Width: 56, Height: 24);
                        Text: "Xbows";
                        Background: #2A2A4E(0.9);
                        OutlineColor: #4A4A7E;
                        OutlineSize: 1;
