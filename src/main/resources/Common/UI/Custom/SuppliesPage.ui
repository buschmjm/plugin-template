Group {
    Anchor: (Full: 0);
    LayoutMode: Center;
    Background: #000000(0.5);

    Group #Panel {
        Anchor: (Width: 760, Height: 560);
        LayoutMode: Top;
        Padding: (Top: 14, Bottom: 14, Left: 14, Right: 14);
        Background: #111122(0.9);
        OutlineColor: #3A3A6E;
        OutlineSize: 2;

        Group #TopBar {
            Anchor: (Height: 36);
            LayoutMode: Left;
            TextButton #BtnBack {
                Anchor: (Width: 70, Height: 30);
                Text: "Back";
                Background: #3A3A5E(0.9);
                OutlineColor: #5A5A8E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Label #Title {
                Anchor: (Width: 560, Height: 36);
                Text: "Supply Shop";
                Style: (FontSize: 20, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
        }

        Group { Anchor: (Height: 4); }

        Group #GoldBar {
            Anchor: (Height: 26);
            Background: #1A1A30(0.9);
            LayoutMode: Left;
            Padding: (Left: 10);
            Label #GoldDisplay {
                Anchor: (Width: 300, Height: 26);
                Text: "Gold: 0g";
                Style: (VerticalAlignment: Center);
            }
        }

        Group { Anchor: (Height: 4); }

        Group #CatRow {
            Anchor: (Height: 28);
            LayoutMode: Left;
            TextButton #CatSERVICES {
                Anchor: (Width: 118, Height: 26);
                Text: "Services";
                Background: #2A2A4E(0.8);
                OutlineColor: #4A4A7E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group { Anchor: (Width: 2); }
            TextButton #CatPOTIONS {
                Anchor: (Width: 118, Height: 26);
                Text: "Potions";
                Background: #2A2A4E(0.8);
                OutlineColor: #4A4A7E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group { Anchor: (Width: 2); }
            TextButton #CatFOOD {
                Anchor: (Width: 118, Height: 26);
                Text: "Food";
                Background: #2A2A4E(0.8);
                OutlineColor: #4A4A7E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group { Anchor: (Width: 2); }
            TextButton #CatBLOCKS {
                Anchor: (Width: 118, Height: 26);
                Text: "Blocks";
                Background: #2A2A4E(0.8);
                OutlineColor: #4A4A7E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group { Anchor: (Width: 2); }
            TextButton #CatMATERIALS {
                Anchor: (Width: 118, Height: 26);
                Text: "Materials";
                Background: #2A2A4E(0.8);
                OutlineColor: #4A4A7E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Group { Anchor: (Width: 2); }
            TextButton #CatGEMS {
                Anchor: (Width: 118, Height: 26);
                Text: "Gems";
                Background: #2A2A4E(0.8);
                OutlineColor: #4A4A7E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
        }

        Group { Anchor: (Height: 4); }

        Group #Body {
            Anchor: (Height: 410);
            LayoutMode: Left;

