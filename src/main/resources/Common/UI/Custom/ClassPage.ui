Group {
    Anchor: (Full: 0);
    LayoutMode: Center;
    Background: #000000(0.5);

    Group #Panel {
        Anchor: (Width: 640, Height: 620);
        LayoutMode: Top;
        Padding: (Top: 16, Bottom: 16, Left: 15, Right: 15);
        Background: #1A1A2E(0.9);
        OutlineColor: #4A4A7E;
        OutlineSize: 2;

        Group #TopBar {
            Anchor: (Height: 36);
            LayoutMode: Left;
            TextButton #BtnBack {
                Anchor: (Width: 80, Height: 30);
                Text: "Back";
                Background: #3A3A5E(0.9);
                OutlineColor: #5A5A8E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Label #PageTitle {
                Anchor: (Width: 510, Height: 36);
                Text: "Class Selection";
                Style: (FontSize: 20, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
        }

        Group { Anchor: (Height: 4); }

        Label #InfoLine1 {
            Anchor: (Height: 22);
            Text: "Active Title: Apprentice";
            Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
        }
        Label #InfoLine2 {
            Anchor: (Height: 20);
            Text: "";
            Style: (HorizontalAlignment: Center, VerticalAlignment: Center);
        }

