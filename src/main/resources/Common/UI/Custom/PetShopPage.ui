Group {
    Anchor: (Full: 0);
    LayoutMode: Center;
    Background: #000000(0.5);

    Group #Panel {
        Anchor: (Width: 720, Height: 460);
        LayoutMode: Top;
        Padding: (Top: 14, Bottom: 14, Left: 14, Right: 14);
        Background: #1A0D1A(0.95);
        OutlineColor: #5E2E7E;
        OutlineSize: 2;

        Group #TopBar {
            Anchor: (Height: 36);
            LayoutMode: Left;
            TextButton #BtnBack {
                Anchor: (Width: 70, Height: 30);
                Text: "Back";
                Background: #2E1A3E(0.9);
                OutlineColor: #6A3A9E;
                OutlineSize: 1;
                Style: (Default: (LabelStyle: (HorizontalAlignment: Center, VerticalAlignment: Center)));
            }
            Label #Title {
                Anchor: (Width: 560, Height: 36);
                Text: "Pet Shop";
                Style: (FontSize: 20, HorizontalAlignment: Center, VerticalAlignment: Center);
            }
        }

        Group { Anchor: (Height: 6); }

        Group #GoldBar {
            Anchor: (Height: 26);
            Background: #150A1E(0.9);
            LayoutMode: Left;
            Padding: (Left: 10);
            Label #GoldDisplay {
                Anchor: (Width: 300, Height: 26);
                Text: "Gold: 0g";
                Style: (VerticalAlignment: Center);
            }
        }

        Group { Anchor: (Height: 8); }

        Group #Body {
            Anchor: (Height: 340);
            LayoutMode: Left;

            Group #LeftPanel {
                Anchor: (Width: 260, Height: 340);
                LayoutMode: Top;

                Group #PetList {
                    Anchor: (Height: 340);
                    LayoutMode: Top;

                    TextButton #Item1 {
                        Anchor: (Height: 44);
                        Text: "";
                        Background: #1E0E2A(0.8);
                        OutlineColor: #4E1E6E;
                        OutlineSize: 1;
                        Padding: (Left: 8);
                        Style: (Default: (LabelStyle: (VerticalAlignment: Center)));
                    }
                    Group { Anchor: (Height: 4); }
                    TextButton #Item2 {
                        Anchor: (Height: 44);
                        Text: "";
                        Background: #1E0E2A(0.8);
                        OutlineColor: #4E1E6E;
                        OutlineSize: 1;
                        Padding: (Left: 8);
                        Style: (Default: (LabelStyle: (VerticalAlignment: Center)));
                    }
                }
            }

            Group #Divider {
                Anchor: (Width: 2, Height: 340);
                Background: #5E2E7E;
            }

            Group #RightPanel {
                Anchor: (Width: 420, Height: 340);
                LayoutMode: Top;
                Padding: (Left: 16, Right: 8);

                Label #DetailName {
                    Anchor: (Height: 36);
                    Text: "Select a Pet";
                    Style: (FontSize: 18, VerticalAlignment: Center);
                }

                Group { Anchor: (Height: 6); }

                Label #DetailDesc {
                    Anchor: (Height: 44);
                    Text: "";
                    Style: (FontSize: 11, VerticalAlignment: Center);
                }

                Group { Anchor: (Height: 10); }

                Group #DetailBox {
                    Anchor: (Height: 184);
                    LayoutMode: Top;
                    Padding: (Top: 8, Bottom: 8, Left: 10, Right: 10);
                    Background: #150A1E(0.9);
                    OutlineColor: #5E2E7E;
                    OutlineSize: 1;

                    Label #DetailRarity {
                        Anchor: (Height: 24);
                        Text: "";
                        Style: (FontSize: 12, VerticalAlignment: Center);
                    }
                    Label #DetailPerks {
                        Anchor: (Height: 24);
                        Text: "";
                        Style: (FontSize: 12, VerticalAlignment: Center);
                    }
                    Label #DetailDamage {
                        Anchor: (Height: 24);
                        Text: "";
                        Style: (FontSize: 12, VerticalAlignment: Center);
                    }
                    Label #DetailHealth {
                        Anchor: (Height: 24);
                        Text: "";
                        Style: (FontSize: 12, VerticalAlignment: Center);
                    }
                    Label #DetailMaxLevel {
                        Anchor: (Height: 24);
                        Text: "";
                        Style: (FontSize: 12, VerticalAlignment: Center);
                    }
                    Label #DetailPrice {
                        Anchor: (Height: 24);
                        Text: "";
                        Style: (FontSize: 14, VerticalAlignment: Center);
                    }
                    Label #DetailCommands {
                        Anchor: (Height: 24);
                        Text: "";
                        Style: (FontSize: 10, VerticalAlignment: Center);
                    }
                }

                Group { Anchor: (Height: 16); }

                Group #ActionRow {
                    Anchor: (Height: 44);
                    LayoutMode: Left;
                    TextButton #BtnBuy {
                        Anchor: (Width: 200, Height: 40);
                        Text: "Buy Pet Egg";
                        Background: #2A1A3A(0.9);
                        OutlineColor: #6A3A9E;
                        OutlineSize: 2;
                        Style: (Default: (LabelStyle: (FontSize: 14, HorizontalAlignment: Center, VerticalAlignment: Center)));
                    }
                }
            }
        }
    }
}
